# Copy to .env (git-ignored) and fill in what you need. scripts/etch reads it; a value set
# in the environment wins over the file. Paths may be absolute, ~/..., or relative to the
# project. Keep the files themselves outside the repository and backed up.

# Hugging Face token, for the art pipeline (tools/generate_art.py, paint_art.py).
HF_TOKEN=

# --- Android release signing -------------------------------------------------------------
# The upload key Play knows this app by. Make it once:
#   keytool -genkeypair -v -keystore etchinstone-release.keystore -alias etchinstone \
#     -keyalg RSA -keysize 2048 -validity 10000
# Losing it means asking Play support to reset the upload key.
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_ALIAS=
ANDROID_KEYSTORE_PASSWORD=

# --- Google Play upload --------------------------------------------------------------------
# A Google Cloud service account's JSON key; in Play Console > Users and permissions,
# invite the account's email with the Release permission for this app.
PLAY_SERVICE_ACCOUNT_JSON=
# internal (default), alpha, beta or production. The menu asks; this is for commands.
PLAY_TRACK=
# completed (default), or draft while the app has never been published.
PLAY_RELEASE_STATUS=

# --- iOS release signing (macOS only) --------------------------------------------------------
# UUID of the App Store distribution profile for com.dangervalentine.etchinstone,
# installed by opening the downloaded .mobileprovision. The Apple Distribution
# certificate must be in the keychain (Xcode > Settings > Accounts > Manage Certificates).
IOS_PROVISIONING_PROFILE_UUID=

# --- TestFlight upload ---------------------------------------------------------------------------
# App Store Connect > Users and Access > Integrations > App Store Connect API: a key with
# the App Manager role. The file must keep its name, AuthKey_<key id>.p8.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=
