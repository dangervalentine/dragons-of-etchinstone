root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{gd,gdshader,tscn,tres,godot,cfg,import,ps1}]
indent_style = tab

[tools/*.sh]
indent_style = tab

[scripts/*.sh]
indent_style = tab

[*.py]
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
