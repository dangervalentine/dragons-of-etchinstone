# Godot 4+
.godot/
*.translation

# Export output
build/*
!build/.gdignore

# Signing
*.keystore
*.jks

# Copyrighted reference material
reference/

.DS_Store

# Agent folder (local skills, may hold credentials)
.claude/

# Python bytecode
__pycache__/

# Local secrets (Hugging Face token etc.); never committed
.env

# Illustrator working files for the art touch-ups
*.ai

# Illustrator working folder for the painted art: .ai files, the frame log and
# exports not yet promoted to art/painted/
art/source/painted/illustrator/

# Store credentials the console reads from .env (specs/018): never committed
*.p8
*.mobileprovision

# Godot's Android build template, installed by the first release build (scripts/etch)
android/

# Art waiting to be imported by scripts/etch art import, and what it has imported
art/staging/
